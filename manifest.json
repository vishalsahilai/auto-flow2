{
  "manifest_version": 3,
  "name": "Auto Prompt",
  "version": "14.5",
  "version_name": "14.5 Flow + Drive",
  "description": "Bulk image-generation automation for Google Flow with direct upload to Google Drive.",
  "minimum_chrome_version": "116",

  "key": "",

  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "identity",
    "alarms",
    "debugger"
  ],

  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://hooks.slack.com/*"
  ],

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open Auto Prompt"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*",
        "https://flow.google.com/*"
      ],
      "js": [
        "config.js",
        "utils/composer.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
